// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  STUDENT
  TEACHER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model User {
  id         String      @id @unique
  email      String      @unique
  name       String
  password   String
  role       UserRole    @default(STUDENT)
  status     UserStatus  @default(ACTIVE)
  batchId    Int?
  profileCompleted Boolean @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  // Relations
  batch      Batch?      @relation(fields: [batchId], references: [id])
  studentRequests  LORRequest[] @relation("StudentRequests")
  teacherRequests  LORRequest[] @relation("TeacherRequests")
  studentProfile StudentProfile?
}

model Batch {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  students    User[]

  @@unique([name])
}

enum LORStatus {
  PENDING
  APPROVED
  REJECTED
}

model LORRequest {
  id         Int       @id @default(autoincrement())
  studentId  String
  teacherId  String
  purpose    String?
  status     LORStatus @default(PENDING)
  comment    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  student    User      @relation("StudentRequests", fields: [studentId], references: [id])
  teacher    User      @relation("TeacherRequests", fields: [teacherId], references: [id])
  documents  SupportingDocument[]
}

model SupportingDocument {
  id           Int        @id @default(autoincrement())
  requestId    Int
  originalName String
  filename     String
  mimeType     String
  size         Int
  createdAt    DateTime   @default(now())

  request      LORRequest @relation(fields: [requestId], references: [id])
  @@index([requestId])
}

model StudentProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  studentId             String
  studentFullName       String
  emailId               String
  admissionMonth        String
  admissionYear         Int
  candidateMobile       String
  parentMobile          String
  bondPeriodCompleted   Boolean
  placementThroughCDPC  Boolean
  letterHeadCount       Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  semesterResults       SemesterResult[]
  universityPreferences UniversityPreference[]
  competitiveExams      CompetitiveExam[]
  facultySelection      String?

  @@index([userId])
}

model SemesterResult {
  id              String         @id @default(cuid())
  profileId       String
  semester        Int
  attendance      Float?
  cgpa            Float?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  profile         StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, semester])
  @@index([profileId])
}

model UniversityPreference {
  id           String         @id @default(cuid())
  profileId    String
  universityName String
  courseName   String
  countryName  String
  intakeMonth  String
  intakeYear   Int
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  // Relations
  profile      StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model CompetitiveExam {
  id           String         @id @default(cuid())
  profileId    String
  examName     String
  score        String?
  scorecardFile String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  // Relations
  profile      StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}